[Unit]
Description=CLIP//NET clipboard history daemon
Documentation=file://@ROOT@/README.md
PartOf=graphical-session.target
After=graphical-session.target
# At login it can start a moment before the compositor is ready; let the
# quick restarts ride that out instead of hitting the default start limit.
StartLimitIntervalSec=60
StartLimitBurst=20

[Service]
Type=simple
ExecStart=@ROOT@/daemon/clipnetd
Restart=on-failure
RestartSec=1
# The daemon owns the clipboard while a pasted clip is on it; give it time to
# checkpoint the database on the way down.
TimeoutStopSec=10

[Install]
WantedBy=graphical-session.target
