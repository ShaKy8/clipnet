# https://editorconfig.org — matches how the code is already written.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab

# Two trailing spaces are a Markdown line break.
[*.md]
trim_trailing_whitespace = false

# Third-party files stay exactly as upstream shipped them.
[daemon/{vendor,protocols}/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
